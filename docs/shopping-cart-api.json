{
  "openapi": "3.0.1",
  "info": {
    "title": "Shopping Cart API",
    "description": "Enterprise Modular Monolith API (Phase 1). Complete specification for Auth, Users, Admin, Products, Cart, and Orders.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:9081",
      "description": "Local Development Server"
    }
  ],
  "tags": [
    { "name": "Auth", "description": "Authentication and Token Rotation" },
    { "name": "Users", "description": "Authenticated Profile Management" },
    { "name": "Admin", "description": "Role-Based Access Control (RBAC)" },
    { "name": "Products (Public)", "description": "Public Catalog Discovery" },
    { "name": "Products (Seller)", "description": "Seller Inventory Management" },
    { "name": "Cart", "description": "Customer Cart Operations" },
    { "name": "Orders", "description": "Order Receipts & History" }
  ],
  "paths": {
    "/api/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register a new Customer account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/RegisterRequest" } }
          }
        },
        "responses": {
          "201": { "description": "User registered successfully" }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Authenticate user and issue tokens",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/LoginRequest" } }
          }
        },
        "responses": {
          "200": { "description": "Login successful. Returns access token in body and sets HttpOnly refresh cookie." }
        }
      }
    },
    "/api/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Rotate refresh token and issue new access token",
        "parameters": [
          { "name": "shopping_refresh", "in": "cookie", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Token rotated successfully" }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Revoke session and clear refresh cookie",
        "responses": {
          "200": { "description": "Logged out successfully" }
        }
      }
    },
    "/api/users/me": {
      "get": {
        "tags": ["Users"],
        "summary": "Get authenticated user profile",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Profile fetched successfully" }
        }
      },
      "patch": {
        "tags": ["Users"],
        "summary": "Update user display name",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/UpdateProfileRequest" } }
          }
        },
        "responses": {
          "200": { "description": "Profile updated successfully" }
        }
      }
    },
    "/api/admin/users/{id}/roles": {
      "put": {
        "tags": ["Admin"],
        "summary": "Update user roles (Requires ADMIN)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/RoleUpdateRequest" } }
          }
        },
        "responses": {
          "200": { "description": "User roles updated successfully" }
        }
      }
    },
    "/api/products": {
      "get": {
        "tags": ["Products (Public)"],
        "summary": "Page active products",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 0 } },
          { "name": "size", "in": "query", "schema": { "type": "integer", "default": 10 } }
        ],
        "responses": {
          "200": { "description": "Products fetched successfully" }
        }
      }
    },
    "/api/products/{id}": {
      "get": {
        "tags": ["Products (Public)"],
        "summary": "Get product by ID",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Product fetched successfully" }
        }
      }
    },
    "/api/products/{id}/thumbnail": {
      "get": {
        "tags": ["Products (Public)"],
        "summary": "Stream product thumbnail image from MongoDB GridFS",
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": {
            "description": "Image binary stream",
            "content": {
              "image/jpeg": { "schema": { "type": "string", "format": "binary" } },
              "image/png": { "schema": { "type": "string", "format": "binary" } }
            }
          }
        }
      }
    },
    "/api/seller/products": {
      "post": {
        "tags": ["Products (Seller)"],
        "summary": "Create a new product with thumbnail (Requires SELLER)",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "product": { "$ref": "#/components/schemas/CreateProductRequest" },
                  "thumbnail": { "type": "string", "format": "binary" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Product created successfully" }
        }
      }
    },
    "/api/seller/products/{id}": {
      "patch": {
        "tags": ["Products (Seller)"],
        "summary": "Partially update product details (Requires owning SELLER)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/UpdateProductRequest" } }
          }
        },
        "responses": {
          "200": { "description": "Product updated successfully" }
        }
      },
      "delete": {
        "tags": ["Products (Seller)"],
        "summary": "Deactivate product (Requires owning SELLER)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Product deactivated successfully" }
        }
      }
    },
    "/api/seller/products/{id}/stock": {
      "patch": {
        "tags": ["Products (Seller)"],
        "summary": "Restock product inventory (Requires owning SELLER)",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/StockUpdateRequest" } }
          }
        },
        "responses": {
          "200": { "description": "Stock updated successfully" }
        }
      }
    },
    "/api/cart": {
      "get": {
        "tags": ["Cart"],
        "summary": "Get current customer's cart",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Cart fetched successfully" }
        }
      }
    },
    "/api/cart/items": {
      "post": {
        "tags": ["Cart"],
        "summary": "Add item to cart",
        "security": [{ "BearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/AddCartItemRequest" } }
          }
        },
        "responses": {
          "200": { "description": "Item added to cart" }
        }
      }
    },
    "/api/cart/items/{cartItemId}": {
      "patch": {
        "tags": ["Cart"],
        "summary": "Update item quantity in cart",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "cartItemId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": { "schema": { "$ref": "#/components/schemas/UpdateCartItemRequest" } }
          }
        },
        "responses": {
          "200": { "description": "Cart updated successfully" }
        }
      },
      "delete": {
        "tags": ["Cart"],
        "summary": "Remove item line from cart",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "cartItemId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Item removed from cart" }
        }
      }
    },
    "/api/cart/checkout": {
      "post": {
        "tags": ["Cart"],
        "summary": "Checkout cart and generate purchase order",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Order placed successfully" }
        }
      }
    },
    "/api/orders": {
      "get": {
        "tags": ["Orders"],
        "summary": "Page authenticated customer's order history",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 0 } },
          { "name": "size", "in": "query", "schema": { "type": "integer", "default": 10 } }
        ],
        "responses": {
          "200": { "description": "Orders fetched successfully" }
        }
      }
    },
    "/api/orders/{id}": {
      "get": {
        "tags": ["Orders"],
        "summary": "Read single order receipt",
        "security": [{ "BearerAuth": [] }],
        "parameters": [
          { "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "Order fetched successfully" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "required": ["username", "email", "password", "displayName"],
        "properties": {
          "username": { "type": "string", "example": "zidan" },
          "email": { "type": "string", "example": "zidan@example.com" },
          "password": { "type": "string", "example": "SuperSecretPassword123" },
          "displayName": { "type": "string", "example": "Zidan Ali" }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["identifier", "password"],
        "properties": {
          "identifier": { "type": "string", "example": "zidan" },
          "password": { "type": "string", "example": "SuperSecretPassword123" }
        }
      },
      "UpdateProfileRequest": {
        "type": "object",
        "required": ["displayName"],
        "properties": {
          "displayName": { "type": "string", "example": "Zidan A." }
        }
      },
      "RoleUpdateRequest": {
        "type": "object",
        "required": ["roles"],
        "properties": {
          "roles": {
            "type": "array",
            "items": { "type": "string", "enum": ["CUSTOMER", "SELLER", "ADMIN"] },
            "example": ["CUSTOMER", "SELLER"]
          }
        }
      },
      "CreateProductRequest": {
        "type": "object",
        "required": ["sku", "name", "description", "price", "stock"],
        "properties": {
          "sku": { "type": "string", "example": "GPU-RTX-5090" },
          "name": { "type": "string", "example": "Nvidia RTX 5090" },
          "description": { "type": "string", "example": "Flagship 32GB GDDR7." },
          "price": { "type": "number", "example": 1999.99 },
          "stock": { "type": "integer", "example": 25 }
        }
      },
      "UpdateProductRequest": {
        "type": "object",
        "properties": {
          "sku": { "type": "string", "example": "GPU-RTX-5090-V2" },
          "name": { "type": "string", "example": "Nvidia RTX 5090 V2" },
          "description": { "type": "string", "example": "Updated description." },
          "price": { "type": "number", "example": 1899.99 },
          "stock": { "type": "integer", "example": 30 }
        }
      },
      "StockUpdateRequest": {
        "type": "object",
        "required": ["stock", "reason"],
        "properties": {
          "stock": { "type": "integer", "example": 40 },
          "reason": { "type": "string", "example": "Warehouse restock batch #104" }
        }
      },
      "AddCartItemRequest": {
        "type": "object",
        "required": ["productId", "quantity"],
        "properties": {
          "productId": { "type": "integer", "example": 1 },
          "quantity": { "type": "integer", "example": 2 }
        }
      },
      "UpdateCartItemRequest": {
        "type": "object",
        "required": ["quantity"],
        "properties": {
          "quantity": { "type": "integer", "example": 4 }
        }
      }
    }
  }
}